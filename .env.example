# Rafiki — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env*`.

# --- WhatsApp (WHAPI) ---
# Reuse the existing Upfleet WHAPI account: copy these two from demo-platform/backend/.env
WHAPI_API_TOKEN=
WHAPI_WEBHOOK_SECRET=
WHAPI_BASE_URL=https://gate.whapi.cloud

# --- Rafiki's brain: pick a provider ---
# LLM_PROVIDER=openai (default) or claude. Flip this one var to switch.
LLM_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic (fallback provider — reuse the key from demo-platform/.env)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8   # or claude-haiku-4-5 for faster replies

# --- Supabase (store + realtime) ---
# Create a NEW Supabase project for Rafiki. Do NOT reuse Upfleet's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
