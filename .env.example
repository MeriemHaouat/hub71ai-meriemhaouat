# Rafiki — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env*`.

# --- WhatsApp (WHAPI) ---
# Reuse the existing Upfleet WHAPI account: copy these two from demo-platform/backend/.env
WHAPI_API_TOKEN=
WHAPI_WEBHOOK_SECRET=
WHAPI_BASE_URL=https://gate.whapi.cloud

# --- Claude / Anthropic (Rafiki's brain) ---
# Reuse the existing key from demo-platform/.env.
ANTHROPIC_API_KEY=
# Optional: default is claude-opus-4-8. For faster/cheaper WhatsApp replies,
# set ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_MODEL=claude-opus-4-8

# --- Supabase (store + realtime) ---
# Create a NEW Supabase project for Rafiki. Do NOT reuse Upfleet's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
